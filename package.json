{
  "name": "gymeat",
  "private": true,
  "version": "1.12.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:app": "cross-env VITE_API_BASE=https://gymeatapp.onrender.com vite build",
    "build:app:cn": "cross-env VITE_API_BASE=https://gymeatapp.onrender.com VITE_APP_REGION=cn vite build",
    "build:app:global": "cross-env VITE_API_BASE=https://gymeatapp.onrender.com VITE_APP_REGION=global vite build",
    "sync:android": "npm run build:app && npx cap sync android",
    "sync:android:cn": "npm run build:app:cn && npx cap sync android",
    "sync:android:global": "npm run build:app:global && npx cap sync android",
    "open:android": "npx cap open android",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gymeat \"vitest run tests/rules\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "~8.4.3",
    "@capacitor/cli": "~8.4.3",
    "@capacitor/core": "~8.4.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "~4.22.3",
    "firebase": "^12.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "~6.4.5",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "firebase-tools": "^14.27.0",
    "vitest": "^3.2.7"
  }
}
